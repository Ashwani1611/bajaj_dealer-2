# ==========================================
# BAJAJ DEALERSHIP - ENVIRONMENT VARIABLES
# ==========================================
# Copy this file and rename it to .env
# Fill in your actual values
# NEVER push .env to GitHub!

# ------------------------------------------
# DJANGO CORE SETTINGS
# ------------------------------------------
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------
DB_NAME=bajaj_dealer_db
DB_USER=your-db-username
DB_PASSWORD=your-db-password
DB_HOST=your-db-host
DB_PORT=5432

# ------------------------------------------
# SOCIAL MEDIA LINKS
# ------------------------------------------
WHATSAPP_NUMBER=your-whatsapp-number
FACEBOOK_URL=your-facebook-page-url
INSTAGRAM_URL=your-instagram-page-url
# YOUTUBE_URL=your-youtube-channel-url

# ------------------------------------------
# GOOGLE MAPS
# ------------------------------------------
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ------------------------------------------
# CLOUDINARY (Image/File Uploads)
# ------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ------------------------------------------
# VAPID KEYS (Push Notifications)
# ------------------------------------------
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_ADMIN_EMAIL=your-admin-email@example.com